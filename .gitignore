# Python runtime files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Generated datasets, checkpoints, and caches
*.mat
*.pth
*_cache.pkl


# Nested comparison results, e.g. compare/UVPL/CAVE/1/result/
/compare/**/[0-9]*/result/

# Method-local experiments:
# compare/<model>/<experiment-id>/
# Ignore everything except record/record.json
/compare/*/[0-9]*/*
!/compare/*/[0-9]*/record/
/compare/*/[0-9]*/record/*
!/compare/*/[0-9]*/record/record.json

# Unified experiments:
# runs/.../<model>/<experiment-id>/
# Ignore everything except record/record.json
/runs/**/[0-9]*/*
!/runs/**/[0-9]*/record/
/runs/**/[0-9]*/record/*
!/runs/**/[0-9]*/record/record.json
