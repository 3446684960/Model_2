# Python runtime files
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Method-local experiments:
# compare/<model>/<experiment-id>/
# Ignore everything except record/record.json
/compare/*/[0-9]*/*
!/compare/*/[0-9]*/record/
/compare/*/[0-9]*/record/*
!/compare/*/[0-9]*/record/record.json

# Unified experiments:
# runs/.../<model>/<experiment-id>/
# Ignore everything except record/record.json
/runs/**/[0-9]*/*
!/runs/**/[0-9]*/record/
/runs/**/[0-9]*/record/*
!/runs/**/[0-9]*/record/record.json
